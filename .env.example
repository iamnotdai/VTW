# Copy to `.env.local` to override locally. All values are optional.

# Public base path the app is served from. Use "/" for a domain root (Netlify, Cloudflare Pages),
# or the repository sub-path for GitHub Pages, e.g. "/VTW/".
VITE_BASE_PATH=/

# "browser" = clean URLs (needs SPA fallback on the host: public/_redirects for Netlify,
# automatic on Cloudflare Pages). "hash" = /#/vocabulary/... URLs that work on any static host
# without server rewrites (recommended for GitHub Pages).
VITE_ROUTER_MODE=browser
